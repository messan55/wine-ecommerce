generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Wine {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  region      String
  appellation String
  cepage      String
  millesime   Int?
  formatLabel String
  color       String
  tastingNote String
  imageSrc    String      @default("")
  priceCents  Int
  stock       Int
  position    Int         @default(0)
  orderLines  OrderLine[]

  @@index([region])
  @@index([color])
  @@index([priceCents])
}

enum OrderStatus {
  pending
  placed
  paid
  shipped
  canceled
  expired
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  shipName     String   @default("")
  shipLine1    String   @default("")
  shipLine2    String   @default("")
  shipPostal   String   @default("")
  shipCity     String   @default("")
  shipPhone    String   @default("")
  createdAt      DateTime         @default(now())
  addresses      Address[]
  orders         Order[]
  passwordResets PasswordReset[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  line1     String
  line2     String   @default("")
  postal    String
  city      String
  phone     String   @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Order {
  id                    String      @id @default(cuid())
  status                OrderStatus @default(pending)
  email                 String?
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  stripeSessionId       String?     @unique
  stripePaymentIntentId String?
  shippingCents         Int         @default(0)
  totalCents            Int
  currency              String      @default("eur")
  shipName              String      @default("")
  shipLine1             String      @default("")
  shipLine2             String      @default("")
  shipPostal            String      @default("")
  shipCity              String      @default("")
  shipCountry           String      @default("FR")
  shipPhone             String      @default("")
  mailedAt              DateTime?
  createdAt             DateTime    @default(now())
  paidAt                DateTime?
  shippedAt             DateTime?
  lines                 OrderLine[]

  @@index([userId])
  @@index([email])
}

model OrderLine {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  wineId    String
  wine      Wine   @relation(fields: [wineId], references: [id])
  slug      String
  name      String
  quantity  Int
  unitCents Int

  @@index([orderId])
  @@index([wineId])
}
